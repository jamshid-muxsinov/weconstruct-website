# .env.dev
# 🚀 ЛОКАЛЬНАЯ РАЗРАБОТКА ПЕРЕМЕННЫЕ
#
# Этот файл используется ТОЛЬКО локально.
# На VDS/production используется .env (исходный)
#
# Использование:
#   cp .env.dev .env.local
#   docker compose --env-file .env.local up
#
# Или просто отредактируй локально перед запуском

# === ПРИЛОЖЕНИЕ ===
PROJECT_NAME=WeConstruct CRM (LOCAL DEV)
DEBUG=true
LOG_LEVEL=DEBUG

# === БЕЗОПАСНОСТЬ (dev-значения) ===
# ВНИМАНИЕ: Никогда не используй эти значения в production!
SECRET_KEY=dev-secret-key-change-me-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === БАЗА ДАННЫХ ===
# Локально используем контейнер PostgreSQL из docker-compose
# Имя хоста 'db' — это имя сервиса в docker-compose
DATABASE_URL=postgresql+asyncpg://store_user:sqwcstore4825@db:5432/storedb

# === REDIS/КЭШИРОВАНИЕ ===
# Опционально: если ты не используешь Redis в dev, закомментируй
# или установи на None для отключения
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true

# === ПЕРВЫЙ АДМИНИСТРАТОР ===
# Автоматически создается при первом запуске
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=admin123

# === CORS ===
# Для локальной разработки:
CORS_ORIGINS=["http://localhost:8000", "http://localhost:8001", "http://127.0.0.1:8000", "http://127.0.0.1:8001"]

# === GOOGLE SHEETS ИНТЕГРАЦИЯ ===
# Опционально для dev (закомментируй если не используешь Google Sheets)
GOOGLE_CREDENTIALS_FILE=/app/credentials.json
GOOGLE_SHEET_WEBHOOK_SECRET="dev-webhook-secret-change-me"
GOOGLE_WEBHOOK_SECRET_KEY="dev-webhook-secret-key-change-me"

# === TELEGRAM ИНТЕГРАЦИЯ ===
# Опционально для dev
# TELEGRAM_BOT_TOKEN=your-bot-token-or-leave-empty
# TELEGRAM_CHAT_ID=your-chat-id-or-leave-empty

# === ДРУГОЕ ===
ROOT_PATH=
